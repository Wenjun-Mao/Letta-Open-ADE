{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private.local/codex-flow/install-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "package_version",
    "setup_mode",
    "repository",
    "project_id",
    "agents",
    "operations",
    "activation_roots",
    "conflicts",
    "applicable",
    "plan_id"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "codex-flow-install-plan" },
    "package_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "setup_mode": { "enum": [null, "new", "existing"] },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "branch", "revision", "cleanliness"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "branch": { "type": ["string", "null"] },
        "revision": { "type": ["string", "null"] },
        "cleanliness": { "type": ["string", "null"], "enum": [null, "clean", "dirty"] }
      }
    },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "path",
        "before_sha256",
        "after_sha256",
        "before_lines",
        "after_lines",
        "contract_version",
        "attestation_reused"
      ],
      "properties": {
        "mode": { "enum": ["managed", "external"] },
        "path": { "type": ["string", "null"] },
        "before_sha256": {
          "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-f0-9]{64}$" }]
        },
        "after_sha256": {
          "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-f0-9]{64}$" }]
        },
        "before_lines": { "type": ["integer", "null"], "minimum": 0 },
        "after_lines": { "type": ["integer", "null"], "minimum": 0 },
        "contract_version": { "type": ["string", "null"] },
        "attestation_reused": { "type": "boolean" }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "action",
          "owner",
          "before_sha256",
          "after_sha256",
          "before_lines",
          "after_lines"
        ],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "action": { "enum": ["create", "update", "delete"] },
          "owner": { "type": "string", "minLength": 1 },
          "before_sha256": {
            "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-f0-9]{64}$" }]
          },
          "after_sha256": {
            "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-f0-9]{64}$" }]
          },
          "before_lines": { "type": ["integer", "null"], "minimum": 0 },
          "after_lines": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "activation_roots": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "path"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "path": { "type": ["string", "null"] }
        }
      }
    },
    "applicable": { "type": "boolean" },
    "plan_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
