{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private.local/codex-flow/host-observation-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "title", "visibility", "model", "reasoning_effort",
    "host_label", "execution_path", "project_placement"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "value", "normalization"],
      "properties": {
        "source": { "enum": ["host-observed", "unavailable"] },
        "value": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 160 }
          ]
        },
        "normalization": { "enum": ["none", "bounded-host-write", "not-applicable"] }
      },
      "oneOf": [
        {
          "properties": {
            "source": { "const": "host-observed" },
            "value": { "type": "string", "minLength": 1, "maxLength": 160 },
            "normalization": { "enum": ["none", "bounded-host-write"] }
          }
        },
        {
          "properties": {
            "source": { "const": "unavailable" },
            "value": { "type": "null" },
            "normalization": { "const": "not-applicable" }
          }
        }
      ]
    },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "value"],
      "properties": {
        "source": { "enum": ["host-observed", "host-contract"] },
        "value": { "type": "boolean" }
      }
    },
    "model": { "$ref": "#/$defs/selectorEvidence" },
    "reasoning_effort": { "$ref": "#/$defs/reasoningEvidence" },
    "host_label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "value"],
      "properties": {
        "source": { "enum": ["host-observed", "unavailable"] },
        "value": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 160 }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "source": { "const": "host-observed" },
            "value": { "type": "string", "minLength": 1, "maxLength": 160 }
          }
        },
        {
          "properties": {
            "source": { "const": "unavailable" },
            "value": { "type": "null" }
          }
        }
      ]
    },
    "execution_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "value"],
      "properties": {
        "source": { "enum": ["host-observed", "not-required", "unavailable"] },
        "value": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 1024 }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "source": { "const": "host-observed" },
            "value": { "type": "string", "minLength": 1, "maxLength": 1024 }
          }
        },
        {
          "properties": {
            "source": { "enum": ["not-required", "unavailable"] },
            "value": { "type": "null" }
          }
        }
      ]
    },
    "project_placement": { "$ref": "#/$defs/projectPlacementEvidence" }
  },
  "$defs": {
    "projectPlacementEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "value"],
      "properties": {
        "source": { "enum": ["host-observed", "host-accepted", "not-applicable", "unavailable"] },
        "value": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/safeId" }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "source": { "enum": ["host-observed", "host-accepted"] },
            "value": { "$ref": "#/$defs/safeId" }
          }
        },
        {
          "properties": {
            "source": { "enum": ["not-applicable", "unavailable"] },
            "value": { "type": "null" }
          }
        }
      ]
    },
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "selectorEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "value"],
      "properties": {
        "source": { "enum": ["host-observed", "host-accepted", "role-contract", "unavailable"] },
        "value": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 128 }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "source": { "enum": ["host-observed", "host-accepted", "role-contract"] },
            "value": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        {
          "properties": {
            "source": { "const": "unavailable" },
            "value": { "type": "null" }
          }
        }
      ]
    },
    "reasoningEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "value"],
      "properties": {
        "source": { "enum": ["host-observed", "host-accepted", "role-contract", "unavailable"] },
        "value": {
          "enum": [null, "none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]
        }
      },
      "oneOf": [
        {
          "properties": {
            "source": { "enum": ["host-observed", "host-accepted", "role-contract"] },
            "value": { "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"] }
          }
        },
        {
          "properties": {
            "source": { "const": "unavailable" },
            "value": { "type": "null" }
          }
        }
      ]
    }
  }
}
