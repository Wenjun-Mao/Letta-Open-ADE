{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private.local/codex-flow/parallel-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "baseline_revision", "max_concurrency", "tasks"],
  "properties": {
    "schema_version": { "const": 2 },
    "plan_id": { "$ref": "#/$defs/safeId" },
    "baseline_revision": { "type": "string", "minLength": 1, "maxLength": 256 },
    "max_concurrency": { "type": "integer", "minimum": 1, "maximum": 32 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "role", "execution_kind", "launch_deadline", "mode", "dependencies", "write_paths", "shared_resources", "serial_gate"],
        "properties": {
          "id": { "$ref": "#/$defs/safeId" },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "role": { "enum": ["coordinator", "executor"] },
          "execution_kind": { "enum": ["task-thread", "subagent"] },
          "launch_deadline": { "$ref": "#/$defs/launchDeadline" },
          "mode": { "enum": ["read", "write"] },
          "dependencies": { "$ref": "#/$defs/safeIds" },
          "write_paths": { "$ref": "#/$defs/paths" },
          "shared_resources": { "$ref": "#/$defs/safeIds64" },
          "serial_gate": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": { "properties": { "mode": { "const": "read" } } },
            "then": { "properties": { "write_paths": { "maxItems": 0 } } },
            "else": { "properties": { "write_paths": { "minItems": 1 } } }
          }
        ]
      }
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "safeIds": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safeId" }
    },
    "safeIds64": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safeId" }
    },
    "launchDeadline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "timezone"],
      "properties": {
        "at": {
          "type": "string",
          "minLength": 20,
          "maxLength": 64,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!\\.?$)(?!/)(?![A-Za-z]:/)(?!\\.git(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[*?\\[\\]{}]).+$"
    },
    "paths": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    }
  }
}
