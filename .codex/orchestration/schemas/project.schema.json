{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private.local/codex-flow/project.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "max_parallel_executors",
    "default_model",
    "default_reasoning_effort",
    "agents_integration",
    "git_lifecycle"
  ],
  "properties": {
    "schema_version": { "const": 4 },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.-]+$" },
    "max_parallel_executors": { "type": "integer", "minimum": 1, "maximum": 32 },
    "default_model": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 128 }
      ]
    },
    "default_reasoning_effort": {
      "type": ["string", "null"],
      "enum": [null, "none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]
    },
    "agents_integration": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "const": "managed" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "path", "sha256", "contract_version", "attested"],
          "properties": {
            "mode": { "const": "external" },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
            },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "contract_version": { "const": "1" },
            "attested": { "const": true }
          }
        }
      ]
    },
    "git_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protected_branches", "warn_at", "block_at"],
      "properties": {
        "protected_branches": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "warn_at": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "block_at": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    }
  }
}
