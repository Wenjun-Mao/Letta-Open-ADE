{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private.local/codex-flow/git-cleanup-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "repository", "include_remote",
    "operation_ids", "candidates", "plan_id"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "codex-flow-git-cleanup-plan" },
    "repository": { "$ref": "#/$defs/repository" },
    "include_remote": { "type": "boolean" },
    "operation_ids": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": { "$ref": "#/$defs/safeId" }
    },
    "candidates": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "plan_id": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "safeId": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "expectedUpstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote", "ref", "remote_identity", "expected_tip"],
      "properties": {
        "remote": {
          "type": "string", "minLength": 1, "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "ref": { "type": "string", "pattern": "^refs/heads/.+", "maxLength": 512 },
        "remote_identity": { "$ref": "#/$defs/digest" },
        "expected_tip": { "$ref": "#/$defs/revision" }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "common_dir", "controller_root", "main_branch", "main_revision", "main_upstream"
      ],
      "properties": {
        "common_dir": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "controller_root": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "main_branch": { "type": "string", "minLength": 1, "maxLength": 256 },
        "main_revision": { "$ref": "#/$defs/revision" },
        "main_upstream": { "$ref": "#/$defs/expectedUpstream" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id", "branch", "worktree_path", "expected_tip", "disposition",
        "remove_worktree", "delete_local", "remote"
      ],
      "properties": {
        "operation_id": { "$ref": "#/$defs/safeId" },
        "branch": { "type": "string", "minLength": 1, "maxLength": 256 },
        "worktree_path": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "expected_tip": { "$ref": "#/$defs/revision" },
        "disposition": { "enum": ["ancestor", "patch-equivalent", "superseded"] },
        "remove_worktree": { "type": "boolean" },
        "delete_local": { "type": "boolean" },
        "remote": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/expectedUpstream" }
          ]
        }
      }
    }
  }
}
