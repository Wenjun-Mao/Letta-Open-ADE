{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private.local/codex-flow/git-branch-claim.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "operation_id", "object_id", "worktree_path",
    "branch", "baseline_revision", "claimed_at", "claim_hash"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "codex-flow-git-branch-claim" },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "worktree_path": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "branch": { "type": "string", "minLength": 1, "maxLength": 256 },
    "baseline_revision": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "claimed_at": { "type": "string", "format": "date-time", "maxLength": 64 },
    "claim_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
