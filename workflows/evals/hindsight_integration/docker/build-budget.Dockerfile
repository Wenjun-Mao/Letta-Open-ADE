FROM python:3.12.12-slim-bookworm@sha256:228390eced221ad2986a3dd77e10b1accca6ba8ceb36f1572de1b346a337cc1a
RUN python -c "import json; from pathlib import Path; q,p=Path('/sys/fs/cgroup/cpu.max').read_text().split(); m=Path('/sys/fs/cgroup/memory.max').read_text().strip(); c=Path('/sys/fs/cgroup/cpuset.cpus.effective').read_text().strip(); assert q != 'max' and int(q)/int(p) <= 3, 'CPU quota not enforced'; assert m != 'max' and int(m) <= 3221225472, 'RAM limit not enforced'; assert c in {'0-2','0,1,2'}, 'Reserved CPU not excluded'; print(json.dumps({'cpu_quota':q,'cpu_period':p,'memory_limit':m,'cpuset':c}))"
