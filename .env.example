COMPOSE_PROJECT_NAME=letta-open-ade

# Bind only the two first-party public surfaces. The model router and PostgreSQL
# remain on the Compose network unless deliberately debugged in-container.
ADE_WEB_BIND_HOST=127.0.0.1
ADE_WEB_PORT=3000
ADE_API_BIND_HOST=127.0.0.1
ADE_API_PORT=8000
# PostgreSQL administrator credentials are used only by PostgreSQL and the
# bootstrap/migration job. Generate a persistent random password.
ADE_PG_ADMIN_USER=ade_admin
ADE_PG_ADMIN_PASSWORD=replace_with_random_ade_admin_password
ADE_PG_ADMIN_DB=postgres

# ADE runtime database and least-privilege application role.
ADE_PG_DB=ade
ADE_PG_OWNER_ROLE=ade_owner
ADE_PG_APP_USER=ade_app
ADE_PG_APP_PASSWORD=replace_with_random_ade_database_password
# ---------- External Provider Secrets (used by model_router upstreams) ----------
OPENAI_API_BASE=https://ark.cn-beijing.volces.com/api/v3
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
OPENAI_API_KEY=replace_with_your_ark_api_key

DOUBAO_CHAT_MODEL=doubao-seed-1-8-251228

# ---------- Unified Model Router (canonical ADE model source of truth) ----------
# `api_key_env` is resolved inside model_router.
# `api_key_secret` is checked first at /run/secrets/<name>.
# Use the tracked portable source catalog, or point this at an ignored local overlay for machine-specific hosts.
# `2234` Unsloth Studio and `1234` LM Studio are standby examples.
# `DGX_VLLM_API_KEY` is optional and blank by default because the local Spark endpoint does not require auth.
# ADE modules use /v1/router/model-catalog and route by canonical `source::model` keys.
# Edit source definitions in config/model-router/sources.json and model defaults in config/model-router/model-profiles.json.
MODEL_ROUTER_API_KEY=replace_with_local_router_key
MODEL_ROUTER_CACHE_TTL_SECONDS=30
MODEL_ROUTER_DISCOVERY_TIMEOUT_SECONDS=5
MODEL_ROUTER_REQUEST_TIMEOUT_SECONDS=600
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
LLAMA_SERVER_API_KEY=
UNSLOTH_API_KEY=
DGX_VLLM_API_KEY=
DGX_EMBEDDING_API_KEY=
# Keep this equal to the manifest route_base_url; a move requires requalification.
QWEN_EMBEDDING_API_BASE=http://dgx-spark:8001/v1
DGX_SPARK_HOST=100.64.35.71
MODEL_ROUTER_SOURCES_FILE=config/model-router/sources.json
MODEL_ROUTER_MODEL_PROFILES_FILE=config/model-router/model-profiles.json
ADE_API_MODEL_ROUTER_BASE_URL=http://model-router:8010

# ---------- ADE API Authentication ----------
# Generate independent random values. The admin key is used only by the frontend
# server and trusted API clients; never expose it through NEXT_PUBLIC_* variables.
ADE_API_AUTH_ENABLED=true
ADE_API_ADMIN_KEY=replace_with_random_admin_key
ADE_API_OPERATOR_KEY=
ADE_API_READER_KEY=
ADE_API_CORS_ORIGINS=

# ---------- Persona Library Storage (used by ade-api) ----------
# Runtime CRUD/search uses SQLite; changed JSONL seed versions synchronize on startup.
ADE_API_RUNTIME_DATA_DIR=data/runtime
ADE_API_PERSONA_DB_PATH=data/runtime/personas/personas.sqlite3
ADE_API_PERSONA_SEED_JSONL_PATH=content/personas/personas.jsonl

# Compose enables the ADE-owned Agent Studio runtime in the unified API process.
ADE_API_AGENT_RUNTIME_ENABLED=true
ADE_API_AGENT_RUNTIME_MODE=development
# Optional shared API/worker pre-request ledger; leave disabled until a stage
# budget is explicitly approved. The path must be under data/runtime.
ADE_API_AGENT_RUNTIME_WORKER_ID=ade-runtime-worker
ADE_API_AGENT_RUNTIME_WORKER_POLL_SECONDS=0.5
ADE_API_AGENT_RUNTIME_LEASE_SECONDS=60
ADE_API_AGENT_RUNTIME_HEARTBEAT_SECONDS=15
ADE_API_AGENT_RUNTIME_WORKER_HEARTBEAT_SECONDS=5
ADE_API_AGENT_RUNTIME_WORKER_STALE_SECONDS=15
ADE_API_AGENT_RUNTIME_STOP_GRACE_PERIOD=650s

# ---------- Comment Lab Runtime Tuning (used by ade-api) ----------
ADE_API_COMMENT_LAB_TIMEOUT_SECONDS=60
ADE_API_COMMENT_LAB_MAX_TOKENS=0
ADE_API_COMMENT_LAB_TASK_SHAPE=classic
ADE_API_COMMENT_LAB_CACHE_PROMPT=false
ADE_API_COMMENT_LAB_TEMPERATURE=0.6
ADE_API_COMMENT_LAB_TOP_P=1.0
ADE_API_COMMENT_LAB_TOP_K=

# ---------- Label Lab Runtime Tuning (used by ade-api) ----------
ADE_API_LABEL_LAB_TIMEOUT_SECONDS=60
ADE_API_LABEL_LAB_MAX_TOKENS=0
ADE_API_LABEL_LAB_REPAIR_RETRY_COUNT=1
ADE_API_LABEL_LAB_TEMPERATURE=0.0
ADE_API_LABEL_LAB_TOP_P=1.0
ADE_API_LABEL_LAB_TOP_K=

# ---------- Agent Studio Runtime Tuning (used by ade-api) ----------
# Agent Studio sampling is optional and only applied at agent creation time.
# Leave blank to let router/provider defaults apply.
ADE_API_AGENT_STUDIO_TEMPERATURE=
ADE_API_AGENT_STUDIO_TOP_P=
ADE_API_AGENT_STUDIO_TOP_K=
